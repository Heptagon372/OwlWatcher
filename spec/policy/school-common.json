  "thresholds": {
    "capsMaxIntervalMs": 300,
    "capsMinTogglesInWindow": 2,
    "capsWindowMs": 1500,
    "debounceMs": 300000,
    "p1EscalationCount": 2,
    "heartbeatOfflineMs": 30000,
    "clockSkewToleranceMs": 30000,
    "captureGuardIntervalMs": 30000,
    "preExamContextMs": 900000
  },
  "captureStackModules": [
    "dxgi.dll",
    "d3d11.dll",
    "windows.graphics.capture.dll",
    "graphicscapture.dll",
    "dwmapi.dll",
    "ScreenCaptureKit.framework"
  ],
  "policyNotes": {
    "vmAllowed": false,
    "text": "이 시험에서는 가상머신 내 응시와 원격제어 도구 실행을 금지한다. 개발 수업 등 VM이 필요한 시험은 강의별 정책에서 vmAllowed를 켠다."
  }
